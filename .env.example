# Firebase Web SDK config — copy this file to `.env` and preencha com os valores do seu projeto.
# Console: https://console.firebase.google.com → ⚙️ Project settings → Your apps → SDK setup and configuration.
# Importante: o prefixo EXPO_PUBLIC_ é necessário para que o Expo exponha as variáveis no bundle.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
